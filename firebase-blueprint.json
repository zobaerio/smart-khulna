{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the user matching Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "description": "Email address of the authenticated user"
        },
        "role": {
          "type": "string",
          "description": "Authorization role of the user",
          "enum": ["super_admin", "sub_admin", "user"]
        },
        "selectedDistrict": {
          "type": "string",
          "description": "Currently selected division district id"
        },
        "savedServices": {
          "type": "array",
          "description": "List of bookmarked service IDs"
        }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Public or district-level community post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "districtId": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "hidden", "removed"] },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorName", "content", "status", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private 1-to-1 chat between two participants",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array" },
        "unreadCounts": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participantIds", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Private chat message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "conversationId", "senderId", "createdAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "User-submitted report on post, comment, user, or message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "reportedByUid": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "targetType", "targetId", "reportedByUid", "reason", "status", "createdAt"]
    },
    "CommunityNotification": {
      "title": "CommunityNotification",
      "description": "In-app notifications for user interactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUid": { "type": "string" },
        "actorUid": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientUid", "title", "message", "isRead", "createdAt"]
    },
    "AppReleaseConfig": {
      "title": "AppReleaseConfig",
      "description": "Cross-platform app versioning, download links, and release notes",
      "type": "object",
      "properties": {
        "currentVersion": { "type": "string" },
        "minimumSupportedVersion": { "type": "string" },
        "releaseDate": { "type": "string" }
      },
      "required": ["currentVersion", "minimumSupportedVersion", "releaseDate"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable log of administrative and system activities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "user", "action", "timestamp"]
    },
    "ServiceSubmission": {
      "title": "ServiceSubmission",
      "description": "Community user submission for local district services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "district_id": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name", "phone", "district_id", "status", "created_at"]
    },
    "DistrictBanner": {
      "title": "DistrictBanner",
      "description": "District-specific or regional promotional and information banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "districtId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "priority": { "type": "number" },
        "link": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "image", "districtId", "isActive"]
    },
    "Like": {
      "title": "Like",
      "description": "User like on a community post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "post_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "post_id", "created_at"]
    },
    "Follow": {
      "title": "Follow",
      "description": "User follow connection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "follower_id": { "type": "string" },
        "following_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "follower_id", "following_id", "created_at"]
    },
    "ProfileVisit": {
      "title": "ProfileVisit",
      "description": "Log of a user visiting another user's profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetUid": { "type": "string" },
        "visitorUid": { "type": "string" },
        "visitorName": { "type": "string" },
        "visitorAvatar": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "targetUid", "visitorUid", "visitorName", "timestamp"]
    },
    "BloodDonor": {
      "title": "BloodDonor",
      "description": "Voluntary blood donor registration in district",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "phone": { "type": "string" },
        "available": { "type": "boolean" },
        "lastDonation": { "type": "string" }
      },
      "required": ["id", "userId", "name", "bloodGroup", "district", "phone"]
    },
    "ServiceReview": {
      "title": "ServiceReview",
      "description": "Citizen rating and feedback for public or emergency services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verifiedCitizen": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "serviceId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Citizen complaint report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "complaint_number": { "type": "string" },
        "user_id": { "type": "string" },
        "category_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "area": { "type": "string" },
        "status": { "type": "string" },
        "assigned_admin_id": { "type": "string" },
        "admin_response": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "resolved_at": { "type": "string" }
      },
      "required": ["id", "complaint_number", "user_id", "category_id", "title", "description", "status", "created_at"]
    },
    "ComplaintMedia": {
      "title": "ComplaintMedia",
      "description": "Media files for complaints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "complaint_id": { "type": "string" },
        "media_url": { "type": "string" },
        "media_type": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "complaint_id", "media_url", "media_type", "created_at"]
    },
    "ComplaintStatusHistory": {
      "title": "ComplaintStatusHistory",
      "description": "History of complaint status changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "complaint_id": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "changed_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "complaint_id", "status", "changed_by", "created_at"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Administrative notice displayed on the top of the app",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "isActive"]
    }
  },
  "firestore": {
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Official public notices created and managed by administrators"
    },
    "/service_reviews/{reviewId}": {
      "schema": "ServiceReview",
      "description": "Citizen ratings and reviews with public read, open create, and author or admin moderation"
    },
    "/complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Citizen complaints"
    },
    "/complaints/{complaintId}/media/{mediaId}": {
      "schema": "ComplaintMedia",
      "description": "Media for complaints"
    },
    "/complaints/{complaintId}/status_history/{historyId}": {
      "schema": "ComplaintStatusHistory",
      "description": "Status history for complaints"
    },
    "/blood_donors/{donorId}": {
      "schema": "BloodDonor",
      "description": "Voluntary blood donors list accessible publicly for emergency blood search"
    },
    "/profiles/{targetUid}/visitors/{visitorUid}": {
      "schema": "ProfileVisit",
      "description": "History of users who visited this profile"
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "Likes on posts, mapped by userId_postId"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follow relations between community users, mapped by followerId_followingId"
    },
    "/banners/{bannerId}": {
      "schema": "DistrictBanner",
      "description": "Promotional and district landmark banners managed by administrators"
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Community posts with public read and author/admin write"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "PostComment",
      "description": "Comments nested within community posts"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Private 1-to-1 conversation metadata accessible strictly to participants"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Private messages accessible strictly to conversation participants"
    },
    "/reports/{reportId}": {
      "schema": "CommunityReport",
      "description": "Moderation reports accessible to reporter and admin moderators"
    },
    "/notifications/{notificationId}": {
      "schema": "CommunityNotification",
      "description": "Private notifications for a specific user"
    },
    "/settings/{settingId}": {
      "schema": "AppReleaseConfig",
      "description": "System settings including app release config and download metadata"
    },
    "/activity_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail of changes made by administrators"
    },
    "/submissions/{submissionId}": {
      "schema": "ServiceSubmission",
      "description": "User-submitted local services pending review"
    },
    "/referral_codes/{codeId}": {
      "schema": "ReferralCode",
      "description": "Mapping from short referral codes to user profiles"
    },
    "/referrals/{referralId}": {
      "schema": "Referral",
      "description": "Recorded referrals tracking invited citizen sign-ups"
    }
  }
}
